# Azure Storage (uses Azure CLI credentials / RBAC - only the account name is needed)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_CONTAINER=customs-documents

# Azure Content Understanding (uses Azure CLI credentials)
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure OpenAI (uses Azure CLI credentials)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-41

# Azure AI Search
AZURE_SEARCH_SERVICE_NAME=your-search-service
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_CONNECTION_NAME=your-search-service

# Azure AI Foundry Project
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-41

# Azure Cosmos DB (uses Azure CLI credentials)
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_DATABASE=customs-workflow
AZURE_COSMOS_CONTAINER=declarations

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
