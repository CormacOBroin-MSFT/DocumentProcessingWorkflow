# =============================================================================
# Backend Environment Variables (.env)
# =============================================================================
# Copy this file to .env and fill in your values.
# All Azure services use DefaultAzureCredential (Azure CLI login) — no keys needed.
# Run: az login
# =============================================================================

# Azure Storage
# Connection string is only used to extract the account name.
# Actual blob access uses DefaultAzureCredential (identity-based auth).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=customs-documents

# Azure Content Understanding
# Endpoint of the AI Services resource where the custom analyzer was created.
# The analyzer must be created manually in Content Understanding Studio.
# See README.md for setup instructions.
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://YOUR-CU-RESOURCE.cognitiveservices.azure.com/
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=CustomsCU

# Azure OpenAI (same AI Services endpoint or separate)
AZURE_OPENAI_ENDPOINT=https://YOUR-AI-SERVICES.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Azure AI Search (for agent tools — HS code lookup, sanctions search)
AZURE_SEARCH_SERVICE_NAME=YOUR-SEARCH-SERVICE
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_CONNECTION_NAME=YOUR-SEARCH-SERVICE

# Azure Cosmos DB (for storing processed declarations)
AZURE_COSMOS_ENDPOINT=https://YOUR-COSMOS-ACCOUNT.documents.azure.com:443/
AZURE_COSMOS_DATABASE=customs-workflow
AZURE_COSMOS_CONTAINER=declarations

# Azure AI Foundry Project (for compliance workflow agents)
AZURE_AI_PROJECT_ENDPOINT=https://YOUR-AI-SERVICES.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1

# Bing Grounding (optional — for web search in agents)
# AZURE_BING_CONNECTION_NAME=YOUR-BING-CONNECTION

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
